---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectSection from '../components/ProjectSection.astro';
import { projects } from '../data/projects';

const shipped = projects.filter(p => !p.wip);
const exploring = projects.filter(p => p.wip);
---

<Layout title="Probably Fine Studios - Showcase">
	<Nav />

	<section class="relative overflow-hidden bg-black">
		<div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px); background-size: 40px 40px"></div>
		<div class="absolute inset-0" style="background: radial-gradient(ellipse 70% 55% at 50% 42%, rgba(99,59,200,0.14) 0%, transparent 70%)"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>

		<div class="relative max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 text-center">
			<img src="/logo-mark.png" alt="PFS" class="h-12 md:h-14 w-auto mx-auto mb-7" width="793" height="259" />
			<h1 class="text-4xl md:text-5xl font-bold text-white mb-5 tracking-tight">Probably Fine Studios</h1>
			<p class="text-lg md:text-xl text-gray-300 mb-8 leading-relaxed">
				Solo studio. Real products. AI doing the heavy lifting.
			</p>
			<div class="flex flex-wrap gap-2 justify-center mb-9 text-xs">
				<a href="#shipped" class="bg-white/5 text-gray-300 px-3 py-1 rounded-full border border-white/10 hover:bg-white/10 transition">{shipped.length} shipped</a>
				<a href="#exploring" class="bg-white/5 text-gray-400 px-3 py-1 rounded-full border border-white/10 hover:bg-white/10 transition">{exploring.length} in the works</a>
			</div>
			<div class="flex gap-3 justify-center">
				<a href="#shipped" class="px-6 py-3 rounded-lg font-semibold text-sm transition hover:opacity-90 bg-white text-black">
					See What Shipped
				</a>
				<a href="/about" class="px-6 py-3 rounded-lg font-semibold text-sm transition border border-white/20 text-white hover:bg-white/10">
					About
				</a>
			</div>
		</div>
	</section>

	<div class="bg-black pb-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<ProjectSection
				id="shipped"
				title="Shipped & Live"
				subtitle="Real products, up and running. Go click around."
				projects={shipped}
				variant="shipped"
			/>

			<div class="my-16 border-t border-zinc-800/70"></div>

			<ProjectSection
				id="exploring"
				title="Exploring & In Progress"
				subtitle="Ideas I'm still poking at. Some will ship, some won't."
				projects={exploring}
				variant="exploring"
			/>
		</div>
	</div>

	<Footer />
</Layout>
