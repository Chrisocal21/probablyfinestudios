---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { teamMembers } from '../data/team';
import { projects } from '../data/projects';

const founder = teamMembers[0];
const allTools = founder.tools
	? [
		...(founder.tools.frontend ?? []),
		...(founder.tools.backend ?? []),
		...(founder.tools.devTools ?? []),
		...(founder.tools.designDeploy ?? []),
		...(founder.tools.apiIntegration ?? []),
	]
	: [];
---

<Layout title="About - Probably Fine Studios">
	<Nav />

	<section class="py-20 bg-black">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

			<!-- Header -->
			<div class="text-center mb-12">
				<p class="text-xs uppercase tracking-[0.3em] font-semibold mb-3" style="color: #a5b4fc">About</p>
				<h1 class="text-4xl md:text-5xl font-bold mb-4 text-white tracking-tight">Who's Behind This</h1>
				<p class="text-lg text-gray-400 max-w-xl mx-auto">
					The talented <span class="line-through decoration-2 text-gray-500">people</span> <span class="text-white font-medium">person</span> behind Probably Fine Studios
				</p>
			</div>

			<!-- Founder profile -->
			<div class="mb-16">
				<div class="bg-zinc-950 rounded-2xl border border-zinc-800 p-8">
					<div class="flex flex-col sm:flex-row gap-6 sm:items-start mb-6">
						<div class="w-16 h-16 rounded-2xl flex-shrink-0 bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center">
							<span class="text-white font-bold text-2xl select-none">{founder.name.charAt(0)}</span>
						</div>
						<div>
							<h2 class="text-2xl font-bold text-white">{founder.name}</h2>
							<p class="text-indigo-300 text-[11px] uppercase tracking-[0.2em] font-semibold mb-3">{founder.role}</p>
							<p class="text-zinc-300 leading-relaxed max-w-2xl">{founder.bio}</p>
						</div>
					</div>

					{founder.links && (
						<div class="flex flex-wrap gap-2 mb-6">
							{founder.links.github && (
								<a href={founder.links.github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-zinc-300 hover:text-white text-sm px-3 py-1.5 rounded-lg border border-zinc-800 hover:border-zinc-600 transition">
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
									GitHub
								</a>
							)}
							{founder.links.linkedin && (
								<a href={founder.links.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-zinc-300 hover:text-white text-sm px-3 py-1.5 rounded-lg border border-zinc-800 hover:border-zinc-600 transition">
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
									LinkedIn
								</a>
							)}
							{founder.links.instagram && (
								<a href={founder.links.instagram} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-zinc-300 hover:text-white text-sm px-3 py-1.5 rounded-lg border border-zinc-800 hover:border-zinc-600 transition">
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
									Instagram
								</a>
							)}
						</div>
					)}

					{allTools.length > 0 && (
						<div>
							<p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-semibold mb-3">Tools & Technologies</p>
							<div class="flex flex-wrap gap-2">
								{allTools.map(tool => (
									<span class="text-zinc-300 text-xs px-2.5 py-1 rounded-full border border-zinc-800">{tool}</span>
								))}
							</div>
						</div>
					)}
				</div>
			</div>

			<!-- Divider -->
			<div class="border-t border-zinc-800 mb-16"></div>

			<!-- About content -->
			<div class="space-y-6">
				<!-- Who We Are -->
				<div class="bg-zinc-950 rounded-2xl p-8 border border-zinc-800">
					<p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-semibold mb-2">The Studio</p>
					<h2 class="text-2xl font-bold mb-4 text-white">Who We Are</h2>
					<p class="text-zinc-300 mb-4 leading-relaxed">
						Probably Fine Studios is a one-person digital studio — Chris at the helm, building apps, tools, and products around ideas that feel worth building, using whatever combination of code, AI, and stubbornness gets the job done.
					</p>
					<p class="text-zinc-300 mb-6 leading-relaxed">
						The name is honest. Nothing here claims to be perfect — but the work ships, the products are real, and they're probably fine.
					</p>

					<div class="flex flex-wrap gap-2">
						<a
							href="https://github.com/Chrisocal21?tab=repositories"
							target="_blank"
							rel="noopener noreferrer"
							class="bg-white/5 text-zinc-200 px-3 py-1.5 rounded-full text-xs border border-white/15 hover:border-white/30 transition"
						>
							45+ Repositories on GitHub
						</a>
						<span class="bg-white/5 text-zinc-300 px-3 py-1.5 rounded-full text-xs border border-white/10">
							Mostly TypeScript
						</span>
						<span class="bg-white/5 text-zinc-300 px-3 py-1.5 rounded-full text-xs border border-white/10">
							{projects.length} Shipped to Production
						</span>
					</div>
				</div>

				<!-- The Origin -->
				<div class="bg-zinc-950 rounded-2xl p-8 border border-zinc-800">
					<p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-semibold mb-2">The Timeline</p>
					<h2 class="text-2xl font-bold mb-6 text-white">How We Got Here</h2>
					<div class="space-y-6">
						<div class="flex gap-4">
							<div class="flex-shrink-0 w-2 rounded-full" style="background: #d6d3d1"></div>
							<div>
								<strong class="text-white text-lg block mb-1">ChrisOCPhoto — The Original</strong>
								<p class="text-zinc-400">It started with photography. ChrisOCPhoto has been the home base for a long time — a personal portfolio built from scratch because nothing else felt right for the work. It's still going, still the OG.</p>
							</div>
						</div>
						<div class="flex gap-4">
							<div class="flex-shrink-0 w-2 rounded-full" style="background: #e879f9"></div>
							<div>
								<strong class="text-white text-lg block mb-1">ChrisOCDigital — Where the Code Started</strong>
								<p class="text-zinc-400">ChrisOCDigital grew out of that same creative energy, born when the code side kicked in. What started as building a better photography site turned into tools, scripts, programs, and experiments — a whole body of work taking shape under one roof. It was the pre-rebuild of ChrisOCPhoto and the stepping stone before Probably Fine Studios existed.</p>
							</div>
						</div>
						<div class="flex gap-4">
							<div class="flex-shrink-0 w-2 rounded-full" style="background: #8b5cf6"></div>
							<div>
								<strong class="text-white text-lg block mb-1">Probably Fine Studios — The Next Step</strong>
								<p class="text-zinc-400">When the projects needed a proper home, Probably Fine Studios became that. A studio name for a body of work that had quietly grown into something real — recipe apps, maps, weather dashboards, field tools, a browser game, and more. Built with AI, shipped with care.</p>
							</div>
						</div>
					</div>
				</div>

				<!-- The Work -->
				<div class="bg-zinc-950 rounded-2xl p-8 border border-zinc-800">
					<div class="flex items-start justify-between gap-4 mb-6 flex-wrap">
						<div>
							<p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-semibold mb-2">The Portfolio</p>
							<h2 class="text-2xl font-bold text-white">The Work</h2>
						</div>
						<a href="/portfolio" class="text-sm text-zinc-400 hover:text-white transition flex items-center gap-1.5 mt-1">
							View all {projects.length}
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
							</svg>
						</a>
					</div>
					<div class="grid sm:grid-cols-2 gap-x-6 gap-y-4">
						{projects.filter(p => !p.wip).map(project => (
							<a href={`/portfolio/${project.id}`} class="border-l-2 pl-4 block group" style={`border-color: ${project.theme?.accent ?? '#6366f1'}`}>
								<strong class="text-white group-hover:underline">{project.title}</strong>
								<p class="text-zinc-400 text-sm mt-1">{project.description}</p>
							</a>
						))}
					</div>
					<p class="text-zinc-500 text-sm mt-6">
						Those are the shipped, polished ones. There's also a growing shelf of in-progress experiments —
						<a href="/portfolio" class="text-zinc-300 hover:text-white underline">{projects.filter(p => p.wip).length} in development</a> right now —
						plus <a href="https://github.com/Chrisocal21?tab=repositories" target="_blank" rel="noopener noreferrer" class="text-zinc-300 hover:text-white underline">45+ repos on GitHub</a> of scripts and half-finished ideas that sometimes turn into the next thing on this page.
					</p>
				</div>
			</div>

			<!-- Divider -->
			<div class="border-t border-zinc-800 my-16"></div>

			<!-- Contact -->
			<div id="contact" class="scroll-mt-24">
				<div class="text-center mb-12">
					<p class="text-xs uppercase tracking-[0.3em] font-semibold mb-3" style="color: #a5b4fc">Get In Touch</p>
					<h2 class="text-4xl font-bold mb-4 text-white">Let's build something</h2>
					<p class="text-xl text-gray-400">
						One person. Real work. Drop me a line.
					</p>
				</div>

				<div class="grid lg:grid-cols-[1fr_320px] gap-6">
					<!-- Form -->
					<div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-6">
						<div class="mb-5">
							<p class="text-xs uppercase tracking-[0.18em] text-zinc-500 mb-2">Contact Form</p>
							<h3 class="text-2xl font-bold text-white">Send a message</h3>
							<p class="text-zinc-400 mt-2 max-w-xl">If you have a project, product, or weirdly specific idea that needs building, send it here. It goes straight into the inbox.</p>
						</div>

						<form id="contact-form" class="space-y-4">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label for="contactName" class="block text-sm text-zinc-300 mb-1">Name</label>
									<input id="contactName" name="contactName" type="text" class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2.5 text-sm text-white" placeholder="Jane Doe" required />
								</div>
								<div>
									<label for="contactEmail" class="block text-sm text-zinc-300 mb-1">Email</label>
									<input id="contactEmail" name="contactEmail" type="email" class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2.5 text-sm text-white" placeholder="jane@example.com" required />
								</div>
							</div>
							<div>
								<label for="contactMessage" class="block text-sm text-zinc-300 mb-1">Message</label>
								<textarea id="contactMessage" name="contactMessage" rows="5" class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-3 text-sm text-white" placeholder="Tell me what you need built." required></textarea>
							</div>
							<div class="hidden" aria-hidden="true">
								<label for="contactCompany">Company</label>
								<input id="contactCompany" name="contactCompany" type="text" tabindex="-1" autocomplete="off" />
							</div>
							<div class="flex flex-wrap items-center gap-3">
								<button id="contactSendBtn" type="submit" class="px-5 py-2.5 rounded-lg font-semibold text-black bg-white hover:bg-gray-200 transition">Send Message</button>
								<span id="contactSendState" class="text-sm text-zinc-400">Goes straight to the inbox.</span>
							</div>
						</form>
					</div>

					<!-- Sidebar: direct + elsewhere -->
					<div class="flex flex-col gap-4">
						<div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-5">
							<p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-semibold mb-3">Direct</p>
							<a href="mailto:hello@probablyfinestudios.com" class="flex items-center gap-3 group">
								<div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center shrink-0 border border-white/10">
									<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
									</svg>
								</div>
								<span class="text-sm text-white group-hover:text-gray-300 transition font-medium break-all">hello@probablyfinestudios.com</span>
							</a>
						</div>

						<div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-5">
							<p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-semibold mb-3">Elsewhere</p>
							<div class="flex flex-col gap-3">
								<a href="https://github.com/Chrisocal21" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 group">
									<div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center shrink-0 border border-white/10">
										<svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
											<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
										</svg>
									</div>
									<span>
										<span class="block text-sm text-white group-hover:text-gray-300 transition font-medium">GitHub</span>
										<span class="block text-xs text-zinc-500">45+ repos</span>
									</span>
								</a>
								<a href="https://www.linkedin.com/in/chrisocphoto" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 group">
									<div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center shrink-0 border border-white/10">
										<svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
											<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
										</svg>
									</div>
									<span class="text-sm text-white group-hover:text-gray-300 transition font-medium">LinkedIn</span>
								</a>
								<a href="https://www.instagram.com/chrisocphoto" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 group">
									<div class="w-9 h-9 rounded-lg bg-white/5 flex items-center justify-center shrink-0 border border-white/10">
										<svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
											<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
										</svg>
									</div>
									<span class="text-sm text-white group-hover:text-gray-300 transition font-medium">Instagram</span>
								</a>
							</div>
						</div>

						<div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-5">
							<p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-semibold mb-3">Snapshot</p>
							<div class="flex flex-wrap gap-2">
								<span class="bg-white/5 text-zinc-300 px-2.5 py-1 rounded-full text-xs border border-white/10">{projects.length} Shipped</span>
								<span class="bg-white/5 text-zinc-300 px-2.5 py-1 rounded-full text-xs border border-white/10">45+ Repos</span>
								<span class="bg-white/5 text-zinc-300 px-2.5 py-1 rounded-full text-xs border border-white/10">Solo Developer</span>
							</div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<script>
		// @ts-nocheck
		const messageEndpoint = 'https://mail.probablyfinestudios.com/api/public/messages';
		const contactForm = document.getElementById('contact-form');
		const contactSendBtn = document.getElementById('contactSendBtn');
		const contactSendState = document.getElementById('contactSendState');

		contactForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!(contactForm instanceof HTMLFormElement)) return;
			if (!contactSendBtn || !contactSendState) return;

			const nameInput = contactForm.elements.namedItem('contactName');
			const emailInput = contactForm.elements.namedItem('contactEmail');
			const messageInput = contactForm.elements.namedItem('contactMessage');
			const companyInput = contactForm.elements.namedItem('contactCompany');
			const name = nameInput instanceof HTMLInputElement ? nameInput.value : '';
			const email = emailInput instanceof HTMLInputElement ? emailInput.value : '';
			const message = messageInput instanceof HTMLTextAreaElement ? messageInput.value : '';
			const company = companyInput instanceof HTMLInputElement ? companyInput.value : '';

			contactSendBtn.setAttribute('disabled', 'true');
			contactSendBtn.classList.add('opacity-60', 'cursor-not-allowed');
			contactSendState.textContent = 'Sending message...';

			try {
				const response = await fetch(messageEndpoint, {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify({
						source_site: 'probablyfinestudios',
						name,
						email,
						message,
						company,
					}),
				});

				const text = await response.text();
				let parsed = text;
				try {
					parsed = JSON.parse(text);
				} catch {
					parsed = text;
				}

				contactSendState.textContent = response.ok ? 'Message sent successfully.' : 'Request failed.';
				if (response.ok) {
					contactForm.reset();
				}
			} catch (error) {
				contactSendState.textContent = 'Network error.';
			} finally {
				contactSendBtn.removeAttribute('disabled');
				contactSendBtn.classList.remove('opacity-60', 'cursor-not-allowed');
			}
		});
	</script>

	<Footer />
</Layout>
