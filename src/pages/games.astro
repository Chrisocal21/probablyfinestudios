---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import ProjectSection from '../components/ProjectSection.astro';
import { projects, liveLabel } from '../data/projects';
import { site, contactLink } from '../data/site';

// The shelf is curated by hand, in this order. Other game-typed projects stay on /portfolio.
const shelfIds = ['zombie-siege', 'supplyline', 'trvlplay'];
const games = shelfIds.flatMap(id => projects.filter(project => project.id === id && project.type === 'game'));

// Every other game still gets a home, below the shelf.
const moreGames = projects.filter(project => project.type === 'game' && !shelfIds.includes(project.id));

// Screenshots made by `npm run screens`; older ones live in public/ and are named in `image`.
const screens = import.meta.glob<ImageMetadata>('../assets/screens/*.webp', { eager: true, import: 'default' });

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Games by Probably Fine Studios',
	url: `${site.url}/games/`,
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: games.map((game, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: game.title,
			url: `${site.url}/portfolio/${game.id}/`,
		})),
	},
};
---

<Layout
	title="Games | Probably Fine Studios"
	description="Games from Probably Fine Studios. Play in the browser, no launcher, no installer, no account. Some are ready, some are still being built."
	jsonLd={jsonLd}
>
	<section class="py-16 md:py-20 bg-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-14">
				<p class="text-xs uppercase tracking-[0.3em] font-semibold mb-3 text-indigo-300">Games</p>
				<h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">Press play</h1>
				<p class="text-lg md:text-xl text-zinc-400 max-w-2xl mx-auto">No launcher, no installer, no account. Click the button and the game opens. (I considered building a launcher. Then I remembered I have games to finish.)</p>
			</div>

			<div class="space-y-10">
				{games.map(game => {
					const accent = game.theme?.accent ?? '#a1a1aa';
					const screenshot = screens[`../assets/screens/${game.id}.webp`];
					const playUrl = game.playUrl ?? game.liveUrl;
					const where = liveLabel({ liveUrl: playUrl });
					return (
						<article class="grid md:grid-cols-2 rounded-2xl overflow-hidden border bg-zinc-950" style={`border-color: ${accent}66`}>
							<div class="relative min-h-56 md:min-h-80 flex items-center justify-center overflow-hidden" style={`background: ${game.theme?.gradient ?? '#18181b'}`}>
								{screenshot ? (
									<Image src={screenshot} alt={`${game.title} screenshot`} widths={[640, 960]} sizes="(min-width: 768px) 560px, 100vw" class="absolute inset-0 w-full h-full object-cover" />
								) : game.image ? (
									<img src={game.image} alt={`${game.title} screenshot`} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
								) : (
									<>
										{game.theme?.pattern && (
											<div class="absolute inset-0" style={`background-image: ${game.theme.pattern}; background-size: ${game.theme.patternSize ?? 'auto'}`}></div>
										)}
										{game.icon && (
											<div class="relative" style={`color: ${accent}`} aria-hidden="true">
												<ProjectIcon icon={game.icon} class="w-20 h-20" />
											</div>
										)}
									</>
								)}
							</div>

							<div class="p-6 md:p-8 flex flex-col gap-4">
								<div>
									<p class="text-[11px] uppercase tracking-[0.2em] font-semibold mb-2" style={`color: ${accent}`}>
										{playUrl ? (game.playLabel ? 'Tester build' : 'Playable now') : 'Coming soon'}{where && playUrl ? ` · ${where}` : ''}
									</p>
									<h2 class="text-3xl font-bold text-white leading-tight mb-3">{game.title}</h2>
									<p class="text-zinc-300 leading-relaxed">{game.description}</p>
								</div>

								<div class="flex flex-wrap gap-2 mt-auto pt-2">
									{playUrl && (
										<a href={playUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg font-semibold text-sm transition hover:opacity-90" style={`background: ${accent}; color: #000`}>
											{game.playLabel ?? 'Play now'}<span class="sr-only">: {game.title} (opens in a new tab)</span>
										</a>
									)}
									{game.steamUrl && (
										<a href={game.steamUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg font-semibold text-sm border border-zinc-600 text-white hover:bg-zinc-800 transition">
											Wishlist on Steam<span class="sr-only">: {game.title} (opens in a new tab)</span>
										</a>
									)}
									{game.trailerUrl && (
										<a href={game.trailerUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg text-sm border border-zinc-700 text-zinc-200 hover:bg-zinc-800 transition">
											Trailer<span class="sr-only">: {game.title} (opens in a new tab)</span>
										</a>
									)}
									<a href={`/portfolio/${game.id}/`} class="px-5 py-2.5 rounded-lg text-sm border border-zinc-700 text-zinc-200 hover:bg-zinc-800 transition">
										About the game<span class="sr-only">: {game.title}</span>
									</a>
								</div>
							</div>
						</article>
					);
				})}
			</div>

			{moreGames.length > 0 && (
				<div class="mt-20">
					<ProjectSection id="more-games" title="More games" subtitle="The rest of the shelf. Some are still being built." projects={moreGames} variant="mixed" />
				</div>
			)}

			<div class="text-center mt-16">
				<p class="text-zinc-400 mb-4">More are on the way. Want to help make one?</p>
				<a href={contactLink({ topic: 'collaboration' })} class="inline-block bg-white text-black px-6 py-3 rounded-lg font-semibold text-sm hover:bg-zinc-200 transition">Come build with me</a>
			</div>
		</div>
	</section>
</Layout>
