---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
import { contactLink } from '../data/site';
import { stops, services, type StopId } from '../data/studio';

// Screenshots made by `npm run screens`; older ones live in public/ and are named in `image`.
const screens = import.meta.glob<ImageMetadata>('../assets/screens/*.webp', { eager: true, import: 'default' });
const screenFor = (id: string, fallback: string) => screens[`../assets/screens/${id}.webp`]?.src ?? (fallback || null);

// The arcade shows games in this order; anything not listed follows.
const gameOrder = ['zombie-siege', 'supplyline', 'salvage-road', 'project-baja', 'scramble', 'trvlplay', 'hang', 'games-collection'];
const rank = (id: string) => {
	const index = gameOrder.indexOf(id);
	return index === -1 ? gameOrder.length : index;
};

const toItem = (project: (typeof projects)[number]) => ({
	id: project.id,
	title: project.title,
	description: project.description,
	url: project.playUrl ?? project.liveUrl ?? null,
	playLabel: project.playLabel ?? null,
	wip: Boolean(project.wip),
	accent: project.theme?.accent ?? '#a1a1aa',
	screen: screenFor(project.id, project.image),
	// Desktop downloads (SupplyLine) are linked out, not embedded.
	embeddable: project.type === 'game' && Boolean(project.playUrl ?? project.liveUrl) && !project.download,
});

const data = {
	games: projects.filter(p => p.type === 'game').sort((a, b) => rank(a.id) - rank(b.id)).map(toItem),
	apps: projects.filter(p => p.type === 'app').map(toItem),
	tools: projects.filter(p => p.type === 'tool').map(toItem),
	links: {
		hire: contactLink({ topic: 'project' }),
		collab: contactLink({ topic: 'collaboration' }),
		hello: contactLink(),
		about: '/about/',
		work: '/portfolio/',
	},
};

// Phones skip the 3D room and get the lobby directory: every department and its suite.
const counts: Partial<Record<StopId, string>> = {
	arcade: `${data.games.length} games`,
	desk: `${data.apps.length} apps`,
	bench: `${data.tools.length} tools`,
};
const phoneOrder: StopId[] = ['arcade', 'desk', 'bench', 'services', 'board', 'coffee'];
const suite: Record<StopId, string> = { arcade: '101', desk: '102', bench: '103', services: '104', board: '105', coffee: 'Lobby' };
const lists: Partial<Record<StopId, ReturnType<typeof toItem>[]>> = { desk: data.apps, bench: data.tools };
---

<Layout
	title="The Studio | Probably Fine Studios"
	description="Walk around the Probably Fine Studios office: the arcade, the main desk, the workbench, and the coffee machine where projects start."
	hideFooter
	navOverlay
	noindex
>
	<section id="studio" class="studio" aria-label="The studio, an interactive 3D room">
		<canvas id="studio-canvas" aria-hidden="true"></canvas>
		<div id="studio-tags" class="studio-tags" aria-hidden="true"></div>

		<div id="studio-intro" class="studio-intro">
			<p class="eyebrow">Games · Apps · Tools</p>
			<h1>Come on in.<br /><span>It's probably fine.</span></h1>
			<p class="lede">Everything in this room is real work. Click around, or scroll for the tour.</p>
		</div>

		<nav id="studio-tour" class="studio-tour" aria-label="Studio tour">
			<button type="button" data-tour="prev" aria-label="Previous stop">←</button>
			<ol id="studio-dots"></ol>
			<button type="button" data-tour="next" aria-label="Next stop">→</button>
		</nav>

		<a href="/portfolio/" class="studio-skip">Skip the tour, just show me the work →</a>

		<aside id="studio-panel" class="studio-panel" aria-live="polite" hidden>
			<button type="button" id="studio-close" class="studio-close" aria-label="Back to the room">✕</button>
			<div id="studio-panel-body"></div>
		</aside>

		<div id="studio-play" class="studio-play" hidden>
			<div class="studio-play-bar">
				<p id="studio-play-title"></p>
				<a id="studio-play-open" href="#" target="_blank" rel="noopener noreferrer">Open in a new tab ↗︎</a>
				<button type="button" id="studio-play-close">Close ✕</button>
			</div>
			<iframe id="studio-play-frame" title="Game" allow="fullscreen; autoplay; gamepad"></iframe>
		</div>

		<div id="studio-loading" class="studio-loading">
			<p>Unlocking the studio…</p>
			<p class="small">(the key is under the mat, probably)</p>
		</div>

		<noscript>
			<div class="studio-loading">
				<p>The studio needs JavaScript to open the door.</p>
				<p class="small"><a href="/portfolio/">See all the work instead →</a></p>
			</div>
		</noscript>
	</section>

	<div class="studio-phone">
		<header class="ph-hero">
			<p class="ph-eyebrow">Games · Apps · Tools</p>
			<h1>Come on in.<br /><span>It's probably fine.</span></h1>
			<p class="ph-lede">On a bigger screen this page is a 3D office you can walk around. Your phone gets the lobby directory instead. Same studio, fewer polygons.</p>
		</header>

		<section class="ph-board" aria-labelledby="ph-board-title">
			<p id="ph-board-title" class="ph-board-title">Directory</p>
			<ol>
				{phoneOrder.map(id => (
					<li>
						<a href={`#ph-${id}`} style={`--accent:${stops[id].accent}`}>
							<span class="ph-dept">{stops[id].short}</span>
							<span class="ph-leader" aria-hidden="true"></span>
							<span class="ph-room">{suite[id]}</span>
						</a>
					</li>
				))}
			</ol>
			<p class="ph-board-note">Visitors, please sign in at the coffee machine.</p>
		</section>

		<nav class="ph-tabs" aria-label="Departments">
			<ol>
				{phoneOrder.map(id => (
					<li><a href={`#ph-${id}`} data-tab={id} style={`--accent:${stops[id].accent}`}>{stops[id].short}</a></li>
				))}
			</ol>
		</nav>

		{phoneOrder.map(id => (
			<section id={`ph-${id}`} class:list={['ph-section', id === 'coffee' && 'ph-cta']} data-section={id} style={`--accent:${stops[id].accent}`}>
				<p class="ph-kicker">{stops[id].place}{counts[id] && ` · ${counts[id]}`}</p>
				<h2>{stops[id].title}</h2>
				<p class="ph-sub">{stops[id].lede}</p>

				{id === 'arcade' && (
					<ol class="ph-games" aria-label="Games">
						{data.games.map(game => (
							<li class="ph-game" style={`--accent:${game.accent}`}>
								{game.screen ? <img src={game.screen} alt="" loading="lazy" decoding="async" /> : <div class="ph-shot-empty" aria-hidden="true">{game.title}</div>}
								<div class="ph-game-body">
									<h3>{game.title}{game.wip && <span class="ph-wip">WIP</span>}</h3>
									<p>{game.description}</p>
									<div class="ph-actions">
										{game.url && <a class="ph-btn is-primary" href={game.url} target="_blank" rel="noopener noreferrer">{game.playLabel ?? 'Play'} ↗︎</a>}
										<a class="ph-btn" href={`/portfolio/${game.id}/`}>About</a>
									</div>
								</div>
							</li>
						))}
					</ol>
				)}

				{lists[id] && (
					<ol class="ph-list">
						{lists[id].map(item => (
							<li style={`--accent:${item.accent}`}>
								{item.screen ? <img src={item.screen} alt="" loading="lazy" decoding="async" /> : <div class="ph-thumb-empty" aria-hidden="true"></div>}
								<div>
									<h3>{item.title}{item.wip && <span class="ph-wip">WIP</span>}</h3>
									<p>{item.description}</p>
									<div class="ph-actions">
										{item.url && <a class="ph-btn is-primary" href={item.url} target="_blank" rel="noopener noreferrer">Visit ↗︎</a>}
										<a class="ph-btn" href={`/portfolio/${item.id}/`}>About</a>
									</div>
								</div>
							</li>
						))}
					</ol>
				)}

				{id === 'board' && (
					<div class="ph-actions">
						<a class="ph-btn is-primary" href={data.links.about}>Read the about page</a>
						<a class="ph-btn" href={data.links.work}>All the work</a>
					</div>
				)}

				{id === 'services' && (
					<>
						<ul class="ph-roles">
							{services.map(r => <li><b>{r.name}</b> {r.note}</li>)}
						</ul>
						<div class="ph-actions">
							<a class="ph-btn is-primary" href={data.links.hire}>Start a project</a>
							<a class="ph-btn" href={data.links.work}>See the work</a>
						</div>
					</>
				)}

				{id === 'coffee' && (
					<div class="ph-actions">
						<a class="ph-btn is-primary" href={data.links.hire}>Start a project</a>
						<a class="ph-btn" href={data.links.hello}>Just say hi</a>
					</div>
				)}
			</section>
		))}

		<p class="ph-foot"><a href="/portfolio/">Every project on one page →</a></p>
	</div>

	<script type="application/json" id="studio-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</Layout>

<script>
	// The 3D room only loads on screens big enough for it; phones get the directory and never download three.js.
	const phone = window.matchMedia('(max-width: 767px)');
	let started = false;
	const startRoom = () => {
		if (started || phone.matches) return;
		started = true;
		import('../scripts/studio').then(({ startStudio }) => startStudio());
	};
	startRoom();
	phone.addEventListener('change', startRoom);

	// Light up the tab for whichever department is on screen.
	const tabs = document.querySelectorAll<HTMLAnchorElement>('.ph-tabs a');
	const tabList = document.querySelector('.ph-tabs ol');
	const spy = new IntersectionObserver(
		entries => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				const id = (entry.target as HTMLElement).dataset.section;
				tabs.forEach(tab => {
					const on = tab.dataset.tab === id;
					if (on) tab.setAttribute('aria-current', 'true');
					else tab.removeAttribute('aria-current');
					if (on && tabList) tabList.scrollTo({ left: tab.offsetLeft - 16, behavior: 'smooth' });
				});
			}
		},
		{ rootMargin: '-35% 0px -60% 0px' },
	);
	document.querySelectorAll('.ph-section').forEach(section => spy.observe(section));
</script>

<style>
	.studio {
		position: relative;
		height: 100svh;
		min-height: 480px;
		overflow: hidden;
		background: #0b0a1a;
	}
	#studio-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		touch-action: pan-y;
	}
	.studio-tags {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	:global(.studio-tag) {
		position: absolute;
		left: 0;
		top: 0;
		transform: translate(-50%, -100%);
		padding: 0.3rem 0.65rem;
		border-radius: 999px;
		background: rgba(10, 10, 20, 0.82);
		border: 1px solid var(--tag, #fcd34d);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
		pointer-events: auto;
		cursor: pointer;
		transition: opacity 0.25s, scale 0.2s;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
	}
	:global(.studio-tag:hover),
	:global(.studio-tag.is-hot) {
		scale: 1.08;
		background: var(--tag, #fcd34d);
		color: #000;
	}
	:global(.studio-tag.is-hidden) {
		opacity: 0;
		pointer-events: none;
	}

	.studio::after {
		content: '';
		position: absolute;
		inset: auto 0 0 0;
		height: 45%;
		background: linear-gradient(to top, rgba(11, 10, 26, 0.92), rgba(11, 10, 26, 0));
		pointer-events: none;
		transition: opacity 0.5s;
	}
	.studio:has(.studio-intro.is-hidden)::after {
		opacity: 0;
	}
	.studio-intro {
		position: absolute;
		left: clamp(1rem, 5vw, 4rem);
		right: clamp(1rem, 5vw, 4rem);
		bottom: 5.5rem;
		max-width: 38rem;
		z-index: 2;
		pointer-events: none;
		transition: opacity 0.5s, translate 0.5s;
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.6);
	}
	.studio-intro.is-hidden {
		opacity: 0;
		translate: 0 -12px;
	}
	.eyebrow {
		font-size: 0.7rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		font-weight: 700;
		color: #fcd34d;
		margin-bottom: 0.75rem;
	}
	.studio-intro h1 {
		font-family: 'Sora Variable', 'Sora', sans-serif;
		font-size: clamp(2rem, 5.5vw, 4.25rem);
		font-weight: 800;
		line-height: 0.98;
		letter-spacing: -0.03em;
	}
	.studio-intro h1 span {
		color: #f0abfc;
	}
	.lede {
		margin-top: 1rem;
		color: #d4d4d8;
		font-size: clamp(0.95rem, 1.6vw, 1.1rem);
	}

	.studio-tour {
		position: absolute;
		left: 50%;
		bottom: 1.25rem;
		translate: -50% 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem;
		border-radius: 999px;
		background: rgba(10, 10, 20, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(8px);
		z-index: 5;
	}
	.studio-tour button {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		color: #fff;
		font-weight: 700;
	}
	.studio-tour button:hover {
		background: rgba(255, 255, 255, 0.12);
	}
	.studio-tour ol {
		display: flex;
		gap: 0.35rem;
	}
	:global(.studio-dot) {
		width: 0.6rem !important;
		height: 0.6rem !important;
		padding: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.3);
	}
	:global(.studio-dot[aria-current='step']) {
		background: #fcd34d;
		width: 1.5rem !important;
	}

	.studio-skip {
		position: absolute;
		right: 1rem;
		bottom: 1.5rem;
		font-size: 0.8rem;
		color: #a1a1aa;
		z-index: 5;
	}
	.studio-skip:hover {
		color: #fff;
	}

	.studio-panel {
		position: absolute;
		top: 5rem;
		right: 1rem;
		bottom: 5rem;
		width: min(30rem, calc(100% - 2rem));
		overflow-y: auto;
		padding: 1.75rem;
		border-radius: 1.25rem;
		background: rgba(9, 9, 15, 0.9);
		border: 1px solid var(--accent, #3f3f46);
		backdrop-filter: blur(14px);
		z-index: 6;
		animation: panel-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	@keyframes panel-in {
		from {
			opacity: 0;
			translate: 24px 0;
		}
	}
	@media (max-width: 767px) {
		.studio-skip {
			display: none;
		}
	}
	.studio-close {
		position: sticky;
		top: 0;
		float: right;
		width: 2.25rem;
		height: 2.25rem;
		margin: -0.5rem -0.5rem 0 0.5rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
	}
	.studio-close:hover {
		background: rgba(255, 255, 255, 0.18);
	}
	:global(.panel-eyebrow) {
		font-size: 0.7rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--accent);
	}
	:global(.panel-title) {
		font-family: 'Sora Variable', 'Sora', sans-serif;
		font-size: 1.9rem;
		font-weight: 800;
		line-height: 1.05;
		margin: 0.4rem 0 0.6rem;
	}
	:global(.panel-lede) {
		color: #d4d4d8;
		margin-bottom: 1.25rem;
	}
	:global(.panel-item) {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: 0.9rem;
		padding: 0.85rem 0;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	:global(.panel-thumb) {
		width: 6.5rem;
		aspect-ratio: 16 / 10;
		border-radius: 0.5rem;
		object-fit: cover;
		background: #18181b;
	}
	:global(.panel-item h3) {
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	:global(.panel-item p) {
		font-size: 0.85rem;
		color: #a1a1aa;
		margin: 0.2rem 0 0.55rem;
		line-height: 1.4;
	}
	:global(.panel-wip) {
		font-size: 0.6rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		padding: 0.1rem 0.4rem;
		border-radius: 999px;
		border: 1px solid #52525b;
		color: #a1a1aa;
	}
	:global(.panel-actions) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	:global(.panel-btn) {
		font-size: 0.78rem;
		font-weight: 600;
		padding: 0.35rem 0.75rem;
		border-radius: 0.45rem;
		border: 1px solid #3f3f46;
		color: #e4e4e7;
	}
	:global(.panel-btn:hover) {
		background: #27272a;
	}
	:global(.panel-btn.is-primary) {
		background: var(--accent);
		border-color: var(--accent);
		color: #000;
	}
	:global(.panel-btn.is-primary:hover) {
		opacity: 0.9;
	}
	:global(.panel-roles) {
		display: grid;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}
	:global(.panel-roles li) {
		padding: 0.65rem 0.85rem;
		border-radius: 0.6rem;
		background: rgba(255, 255, 255, 0.05);
		font-size: 0.9rem;
	}
	:global(.panel-roles li b) {
		color: var(--accent);
	}

	.studio-play {
		position: absolute;
		inset: 0;
		z-index: 20;
		display: flex;
		flex-direction: column;
		background: #000;
	}
	.studio-play[hidden] {
		display: none;
	}
	.studio-play-bar {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.6rem 1rem;
		background: #09090b;
		border-bottom: 1px solid #27272a;
		font-size: 0.85rem;
	}
	.studio-play-bar p {
		font-weight: 700;
		margin-right: auto;
	}
	.studio-play-bar a {
		color: #a1a1aa;
	}
	.studio-play-bar a:hover {
		color: #fff;
	}
	.studio-play-bar button {
		padding: 0.35rem 0.8rem;
		border-radius: 0.4rem;
		background: #fff;
		color: #000;
		font-weight: 700;
	}
	.studio-play iframe {
		flex: 1;
		width: 100%;
		border: 0;
	}

	.studio-loading {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		text-align: center;
		gap: 0.35rem;
		background: #0b0a1a;
		z-index: 30;
		transition: opacity 0.6s;
		font-family: 'Sora Variable', 'Sora', sans-serif;
		font-size: 1.25rem;
		font-weight: 700;
	}
	.studio-loading .small {
		font-family: inherit;
		font-size: 0.85rem;
		font-weight: 400;
		color: #a1a1aa;
	}
	.studio-loading.is-done {
		opacity: 0;
		pointer-events: none;
	}

	/* ---------- phones: no 3D room, just the lobby directory and the departments ---------- */
	.studio-phone {
		display: none;
	}
	@media (max-width: 767px) {
		.studio {
			display: none;
		}
		.studio-phone {
			display: block;
			background:
				radial-gradient(120% 40rem at 100% 0%, rgba(139, 92, 246, 0.22), transparent 60%),
				radial-gradient(90% 30rem at 0% 8rem, rgba(240, 171, 252, 0.12), transparent 60%),
				#0b0a1a;
			color: #fff;
			padding-bottom: env(safe-area-inset-bottom);
		}
	}
	.ph-hero {
		padding: 6.5rem 1.25rem 1.75rem;
	}
	.ph-eyebrow,
	.ph-kicker {
		font-size: 0.66rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		font-weight: 700;
		color: #fcd34d;
	}
	.ph-kicker {
		color: var(--accent);
	}
	.ph-hero h1 {
		margin-top: 0.75rem;
		font-family: 'Sora Variable', 'Sora', sans-serif;
		font-size: clamp(2.3rem, 11vw, 3rem);
		font-weight: 800;
		line-height: 0.98;
		letter-spacing: -0.035em;
	}
	.ph-hero h1 span {
		color: #f0abfc;
	}
	.ph-lede {
		margin-top: 1rem;
		color: #d4d4d8;
		font-size: 0.98rem;
		line-height: 1.55;
	}

	/* The lobby letter board. */
	.ph-board {
		margin: 0 1.25rem;
		padding: 1.1rem 1rem 0.9rem;
		border-radius: 0.6rem;
		border: 6px solid #2a2433;
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.06),
			0 20px 40px rgba(0, 0, 0, 0.45);
		background: repeating-linear-gradient(to bottom, #141218 0 9px, #0b0a0e 9px 10px);
		font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
		text-transform: uppercase;
