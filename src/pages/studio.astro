---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
import { contactLink } from '../data/site';

// Screenshots made by `npm run screens`; older ones live in public/ and are named in `image`.
const screens = import.meta.glob<ImageMetadata>('../assets/screens/*.webp', { eager: true, import: 'default' });
const screenFor = (id: string, fallback: string) => screens[`../assets/screens/${id}.webp`]?.src ?? (fallback || null);

// The arcade shows games in this order; anything not listed follows.
const gameOrder = ['zombie-siege', 'supplyline', 'salvage-road', 'project-baja', 'scramble', 'trvlplay', 'hang', 'games-collection'];
const rank = (id: string) => {
	const index = gameOrder.indexOf(id);
	return index === -1 ? gameOrder.length : index;
};

const toItem = (project: (typeof projects)[number]) => ({
	id: project.id,
	title: project.title,
	description: project.description,
	url: project.playUrl ?? project.liveUrl ?? null,
	playLabel: project.playLabel ?? null,
	wip: Boolean(project.wip),
	accent: project.theme?.accent ?? '#a1a1aa',
	screen: screenFor(project.id, project.image),
	// Desktop downloads (SupplyLine) are linked out, not embedded.
	embeddable: project.type === 'game' && Boolean(project.playUrl ?? project.liveUrl) && !project.download,
});

const data = {
	games: projects.filter(p => p.type === 'game').sort((a, b) => rank(a.id) - rank(b.id)).map(toItem),
	apps: projects.filter(p => p.type === 'app').map(toItem),
	tools: projects.filter(p => p.type === 'tool').map(toItem),
	links: {
		hire: contactLink({ topic: 'project' }),
		collab: contactLink({ topic: 'collaboration' }),
		hello: contactLink(),
		about: '/about/',
		work: '/portfolio/',
	},
	portrait: '/images/compressed-Chris.jpg',
};
---

<Layout
	title="The Studio | Probably Fine Studios"
	description="Walk around the Probably Fine Studios office. It is one guy, a lot of projects, and several empty desks."
	hideFooter
	navOverlay
	noindex
>
	<section id="studio" class="studio" aria-label="The studio, an interactive 3D room">
		<canvas id="studio-canvas" aria-hidden="true"></canvas>
		<div id="studio-tags" class="studio-tags" aria-hidden="true"></div>

		<div id="studio-intro" class="studio-intro">
			<p class="eyebrow">Probably Fine Studios · Est. one guy</p>
			<h1>A whole studio.<br /><span>Staffed by Chris.</span></h1>
			<p class="lede">Everything in this room is real work. Click around, or scroll for the tour.</p>
		</div>

		<nav id="studio-tour" class="studio-tour" aria-label="Studio tour">
			<button type="button" data-tour="prev" aria-label="Previous stop">←</button>
			<ol id="studio-dots"></ol>
			<button type="button" data-tour="next" aria-label="Next stop">→</button>
		</nav>

		<a href="/portfolio/" class="studio-skip">Skip the tour, just show me the work →</a>

		<aside id="studio-panel" class="studio-panel" aria-live="polite" hidden>
			<button type="button" id="studio-close" class="studio-close" aria-label="Back to the room">✕</button>
			<div id="studio-panel-body"></div>
		</aside>

		<div id="studio-play" class="studio-play" hidden>
			<div class="studio-play-bar">
				<p id="studio-play-title"></p>
				<a id="studio-play-open" href="#" target="_blank" rel="noopener noreferrer">Open in a new tab ↗︎</a>
				<button type="button" id="studio-play-close">Close ✕</button>
			</div>
			<iframe id="studio-play-frame" title="Game" allow="fullscreen; autoplay; gamepad"></iframe>
		</div>

		<div id="studio-loading" class="studio-loading">
			<p>Unlocking the studio…</p>
			<p class="small">(the key is under the mat, probably)</p>
		</div>

		<noscript>
			<div class="studio-loading">
				<p>The studio needs JavaScript to open the door.</p>
				<p class="small"><a href="/portfolio/">See all the work instead →</a></p>
			</div>
		</noscript>
	</section>

	<script type="application/json" id="studio-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</Layout>

<script>
	import { startStudio } from '../scripts/studio';
	startStudio();
</script>

<style>
	.studio {
		position: relative;
		height: 100svh;
		min-height: 480px;
		overflow: hidden;
		background: #0b0a1a;
	}
	#studio-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		touch-action: pan-y;
	}
	.studio-tags {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	:global(.studio-tag) {
		position: absolute;
		left: 0;
		top: 0;
		transform: translate(-50%, -100%);
		padding: 0.3rem 0.65rem;
		border-radius: 999px;
		background: rgba(10, 10, 20, 0.82);
		border: 1px solid var(--tag, #fcd34d);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
		pointer-events: auto;
		cursor: pointer;
		transition: opacity 0.25s, scale 0.2s;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
	}
	:global(.studio-tag:hover),
	:global(.studio-tag.is-hot) {
		scale: 1.08;
		background: var(--tag, #fcd34d);
		color: #000;
	}
	:global(.studio-tag.is-hidden) {
		opacity: 0;
		pointer-events: none;
	}

	.studio::after {
		content: '';
		position: absolute;
		inset: auto 0 0 0;
		height: 45%;
		background: linear-gradient(to top, rgba(11, 10, 26, 0.92), rgba(11, 10, 26, 0));
		pointer-events: none;
		transition: opacity 0.5s;
	}
	.studio:has(.studio-intro.is-hidden)::after {
		opacity: 0;
	}
	.studio-intro {
		position: absolute;
		left: clamp(1rem, 5vw, 4rem);
		bottom: 5.5rem;
		max-width: 38rem;
		z-index: 2;
		pointer-events: none;
		transition: opacity 0.5s, translate 0.5s;
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.6);
	}
	.studio-intro.is-hidden {
		opacity: 0;
		translate: 0 -12px;
	}
	.eyebrow {
		font-size: 0.7rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		font-weight: 700;
		color: #fcd34d;
		margin-bottom: 0.75rem;
	}
	.studio-intro h1 {
		font-family: 'Sora Variable', 'Sora', sans-serif;
		font-size: clamp(2rem, 5.5vw, 4.25rem);
		font-weight: 800;
		line-height: 0.98;
		letter-spacing: -0.03em;
	}
	.studio-intro h1 span {
		color: #f0abfc;
	}
	.lede {
		margin-top: 1rem;
		color: #d4d4d8;
		font-size: clamp(0.95rem, 1.6vw, 1.1rem);
	}

	.studio-tour {
		position: absolute;
		left: 50%;
		bottom: 1.25rem;
		translate: -50% 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem;
		border-radius: 999px;
		background: rgba(10, 10, 20, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(8px);
		z-index: 5;
	}
	.studio-tour button {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		color: #fff;
		font-weight: 700;
	}
	.studio-tour button:hover {
		background: rgba(255, 255, 255, 0.12);
	}
	.studio-tour ol {
		display: flex;
		gap: 0.35rem;
	}
	:global(.studio-dot) {
		width: 0.6rem !important;
		height: 0.6rem !important;
		padding: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.3);
	}
	:global(.studio-dot[aria-current='step']) {
		background: #fcd34d;
		width: 1.5rem !important;
	}

	.studio-skip {
		position: absolute;
		right: 1rem;
		bottom: 1.5rem;
		font-size: 0.8rem;
		color: #a1a1aa;
		z-index: 5;
	}
	.studio-skip:hover {
		color: #fff;
	}

	.studio-panel {
		position: absolute;
		top: 5rem;
		right: 1rem;
		bottom: 5rem;
		width: min(30rem, calc(100% - 2rem));
		overflow-y: auto;
		padding: 1.75rem;
		border-radius: 1.25rem;
		background: rgba(9, 9, 15, 0.9);
		border: 1px solid var(--accent, #3f3f46);
		backdrop-filter: blur(14px);
		z-index: 6;
		animation: panel-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	@keyframes panel-in {
		from {
			opacity: 0;
			translate: 24px 0;
		}
	}
	@media (max-width: 767px) {
		.studio-panel {
			top: auto;
			left: 0.75rem;
			right: 0.75rem;
			bottom: 4.5rem;
			width: auto;
			max-height: 58%;
		}
		.studio-skip {
			display: none;
		}
	}
	.studio-close {
		position: sticky;
		top: 0;
		float: right;
		width: 2.25rem;
		height: 2.25rem;
		margin: -0.5rem -0.5rem 0 0.5rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
	}
	.studio-close:hover {
		background: rgba(255, 255, 255, 0.18);
	}
	:global(.panel-eyebrow) {
		font-size: 0.7rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--accent);
	}
	:global(.panel-title) {
		font-family: 'Sora Variable', 'Sora', sans-serif;
		font-size: 1.9rem;
		font-weight: 800;
		line-height: 1.05;
		margin: 0.4rem 0 0.6rem;
	}
	:global(.panel-lede) {
		color: #d4d4d8;
		margin-bottom: 1.25rem;
	}
	:global(.panel-item) {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: 0.9rem;
		padding: 0.85rem 0;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	:global(.panel-thumb) {
		width: 6.5rem;
		aspect-ratio: 16 / 10;
		border-radius: 0.5rem;
		object-fit: cover;
		background: #18181b;
	}
	:global(.panel-item h3) {
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	:global(.panel-item p) {
		font-size: 0.85rem;
		color: #a1a1aa;
		margin: 0.2rem 0 0.55rem;
		line-height: 1.4;
	}
	:global(.panel-wip) {
		font-size: 0.6rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		padding: 0.1rem 0.4rem;
		border-radius: 999px;
		border: 1px solid #52525b;
		color: #a1a1aa;
	}
	:global(.panel-actions) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	:global(.panel-btn) {
		font-size: 0.78rem;
		font-weight: 600;
		padding: 0.35rem 0.75rem;
		border-radius: 0.45rem;
		border: 1px solid #3f3f46;
		color: #e4e4e7;
	}
	:global(.panel-btn:hover) {
		background: #27272a;
	}
	:global(.panel-btn.is-primary) {
		background: var(--accent);
		border-color: var(--accent);
		color: #000;
	}
	:global(.panel-btn.is-primary:hover) {
		opacity: 0.9;
	}
	:global(.panel-roles) {
		display: grid;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}
	:global(.panel-roles li) {
		padding: 0.65rem 0.85rem;
		border-radius: 0.6rem;
		background: rgba(255, 255, 255, 0.05);
		font-size: 0.9rem;
	}
	:global(.panel-roles li b) {
		color: var(--accent);
	}

	.studio-play {
		position: absolute;
		inset: 0;
		z-index: 20;
		display: flex;
		flex-direction: column;
		background: #000;
	}
	.studio-play[hidden] {
		display: none;
	}
	.studio-play-bar {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.6rem 1rem;
		background: #09090b;
		border-bottom: 1px solid #27272a;
		font-size: 0.85rem;
	}
	.studio-play-bar p {
		font-weight: 700;
		margin-right: auto;
	}
	.studio-play-bar a {
		color: #a1a1aa;
	}
	.studio-play-bar a:hover {
		color: #fff;
	}
	.studio-play-bar button {
		padding: 0.35rem 0.8rem;
		border-radius: 0.4rem;
		background: #fff;
		color: #000;
		font-weight: 700;
	}
	.studio-play iframe {
		flex: 1;
		width: 100%;
		border: 0;
	}

	.studio-loading {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		text-align: center;
		gap: 0.35rem;
		background: #0b0a1a;
		z-index: 30;
		transition: opacity 0.6s;
		font-family: 'Sora Variable', 'Sora', sans-serif;
		font-size: 1.25rem;
		font-weight: 700;
	}
	.studio-loading .small {
		font-family: inherit;
		font-size: 0.85rem;
		font-weight: 400;
		color: #a1a1aa;
	}
	.studio-loading.is-done {
		opacity: 0;
		pointer-events: none;
	}
</style>
