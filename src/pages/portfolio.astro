---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectSection from '../components/ProjectSection.astro';
import { projects } from '../data/projects';

const shipped = projects.filter(p => !p.wip);
const exploring = projects.filter(p => p.wip);
---

<Layout title="Portfolio - Probably Fine Studios">
	<Nav />

	<section class="py-20 bg-black">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
				<h1 class="text-5xl font-bold mb-4 text-white">All Projects</h1>
				<p class="text-xl text-gray-400">Here's what shipped. Here's what's next.</p>
			</div>

			<ProjectSection
				id="shipped"
				title="Shipped & Live"
				subtitle="Real products, up and running. Go click around."
				projects={shipped}
				variant="shipped"
			/>

			<div class="my-16 border-t border-zinc-800/70"></div>

			<ProjectSection
				id="exploring"
				title="Exploring & In Progress"
				subtitle="Ideas I'm still poking at. Some will ship, some won't."
				projects={exploring}
				variant="exploring"
			/>
		</div>
	</section>

	<Footer />
</Layout>
