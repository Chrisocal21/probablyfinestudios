---
import sharp from 'sharp';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ProjectIcon from '../../components/ProjectIcon.astro';
import { projects, liveLabel } from '../../data/projects';
import { site, contactLink } from '../../data/site';
import { profile } from '../../data/profile';
import captured from '../../assets/screens/captured.json';

// Screenshots made by `npm run screens`; a project gets one when src/assets/screens/<id>.webp exists.
const screens = import.meta.glob<ImageMetadata>('../../assets/screens/*.webp', { eager: true, import: 'default' });

export function getStaticPaths() {
	return projects.map((project, index) => ({
		params: { id: project.id },
		props: {
			project,
			previous: projects[(index - 1 + projects.length) % projects.length],
			next: projects[(index + 1) % projects.length],
		},
	}));
}

const { project, previous, next } = Astro.props;
const { id, title, description, longDescription, invite, role, stack, highlights, image, icon, tags, liveUrl, liveNote, download, githubUrl, wip, theme, collaborators } = project;

const screenshot = screens[`../../assets/screens/${id}.webp`];
// A full-browser capture fills the column; a smaller one (a desktop app window, say) is shown at its own size.
const narrowScreenshot = Boolean(screenshot && screenshot.width < 1000);
const screenshotWidths = screenshot ? [640, 960, 1280].filter(width => width < screenshot.width).concat(Math.min(screenshot.width, 1280)) : [];
const capturedOn = (captured as Record<string, string>)[id];
const capturedLabel = capturedOn
	? new Date(`${capturedOn}T12:00:00`).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
	: null;

const accent = theme?.accent ?? '#a5b4fc';
const gradient = theme?.gradient ?? 'linear-gradient(135deg, #312e81, #1e1b4b)';
const where = liveLabel(project);
const pageUrl = `${site.url}/portfolio/${id}/`;
const talkLink = contactLink({ topic: 'collaboration', project: id });

// Older screenshots live in public/ and are named in the project's `image` field. Read the real
// pixel size so the page doesn't jump while one loads.
const legacyImage = !screenshot && image ? image : null;
const imageSize = legacyImage ? await sharp(`public${legacyImage}`).metadata().catch(() => null) : null;

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: title,
		description,
		url: pageUrl,
		keywords: [...tags, ...(stack ?? [])].join(', '),
		creativeWorkStatus: wip ? 'In development' : 'Published',
		author: { '@type': 'Person', name: profile.name, url: `${site.url}/about/` },
		publisher: { '@type': 'Organization', name: site.name, url: `${site.url}/` },
		...(liveUrl ? { sameAs: liveUrl } : {}),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
			{ '@type': 'ListItem', position: 2, name: 'Projects', item: `${site.url}/portfolio/` },
			{ '@type': 'ListItem', position: 3, name: title, item: pageUrl },
		],
	},
];
---

<Layout
	title={`${title} | Probably Fine Studios`}
	description={description}
	image={`/og/${id}.png`}
	imageAlt={`${title}: ${description}`}
	type="article"
	jsonLd={jsonLd}
>
	<section class="relative overflow-hidden pt-12 pb-16 md:pt-16 md:pb-20" style={`background: ${gradient}`}>
		{theme?.pattern && (
			<div class="absolute inset-0" style={`background-image: ${theme.pattern}; background-size: ${theme.patternSize ?? 'auto'}`}></div>
		)}
		<div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/50 to-black"></div>
		<div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<a href="/portfolio/" class="inline-flex items-center gap-2 text-sm text-white/80 hover:text-white transition mb-10">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
				</svg>
				All projects
			</a>

			<div class="flex items-center gap-4 sm:gap-5 mb-5">
				{icon && (
					<div
						class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center border shrink-0 backdrop-blur-sm"
						style={`background: ${accent}1a; border-color: ${accent}55; color: ${accent}`}
					>
						<ProjectIcon icon={icon} class="w-7 h-7 sm:w-8 sm:h-8" />
					</div>
				)}
				<div class="min-w-0">
					<h1 class="text-4xl md:text-5xl font-bold text-white leading-tight">{title}</h1>
				</div>
			</div>

			<p class="text-xs sm:text-sm uppercase tracking-[0.25em] font-semibold mb-6 flex flex-wrap items-center gap-x-3 gap-y-2" style={`color: ${accent}`}>
				<span>{role ?? tags[0]}{where ? ` · ${where}` : ''}</span>
				<span class="text-[10px] font-medium tracking-widest px-2.5 py-1 rounded-full" style={`background: ${accent}1f; border: 1px solid ${accent}55`}>
					{wip ? 'In development' : 'Shipped and live'}
				</span>
			</p>

			<p class="text-xl md:text-2xl text-zinc-100 max-w-3xl leading-relaxed mb-8">{description}</p>

			<ul class="flex flex-wrap gap-2 mb-9" aria-label="Categories">
				{tags.map(tag => (
					<li class="bg-white/10 text-white px-3 py-1 rounded-full text-sm" style={`border: 1px solid ${accent}40`}>{tag}</li>
				))}
			</ul>

			<div class="flex flex-wrap gap-3">
				{liveUrl && (
					<a
						href={liveUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="group px-6 py-3 rounded-lg font-semibold text-sm transition hover:opacity-90 flex items-center gap-2"
						style={`background: ${accent}; color: #000`}
					>
						Visit the live site
						<svg class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7m0 0H8m9 0v9"/>
						</svg>
						<span class="sr-only">(opens in a new tab)</span>
					</a>
				)}
				{download && (download.url ? (
					<a href={download.url} class="px-6 py-3 rounded-lg font-semibold text-sm transition hover:opacity-90" style={`background: ${accent}; color: #000`}>
						{download.label}
					</a>
				) : (
					<span class="px-6 py-3 rounded-lg font-semibold text-sm border border-dashed border-white/40 text-zinc-200">
						{download.label}: coming soon
					</span>
				))}
				{githubUrl && (
					<a href={githubUrl} target="_blank" rel="noopener noreferrer" class="bg-white/10 text-white px-6 py-3 rounded-lg font-semibold text-sm hover:bg-white/20 transition border border-white/20">
						View the code<span class="sr-only"> (opens in a new tab)</span>
					</a>
				)}
				<a href={talkLink} class="bg-black/30 text-white px-6 py-3 rounded-lg font-semibold text-sm hover:bg-white/10 transition border border-white/25">
					Talk to me about {title}
				</a>
			</div>
			{liveNote && <p class="mt-4 text-sm text-zinc-300">{liveNote}</p>}
		</div>
	</section>

	<section class="pt-12 md:pt-16 bg-black">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			{screenshot && (
				<figure class="mb-14 mx-auto" style={narrowScreenshot ? `max-width: ${screenshot.width}px` : undefined}>
					<Image
						src={screenshot}
						alt={`Screenshot of ${title}`}
						widths={screenshotWidths}
						sizes={narrowScreenshot ? `(min-width: ${screenshot.width}px) ${screenshot.width}px, 100vw` : '(min-width: 1024px) 960px, 100vw'}
						class="w-full h-auto rounded-xl border border-zinc-800"
					/>
					<figcaption class="mt-3 text-xs text-zinc-400">
						{capturedLabel ? `The live product, captured ${capturedLabel}.` : `${title}, up and running.`}
					</figcaption>
				</figure>
			)}
			{legacyImage && (
				<figure class="rounded-xl overflow-hidden border border-zinc-800 mb-14">
					<img
						src={legacyImage}
						alt={`Screenshot of ${title}`}
						width={imageSize?.width}
						height={imageSize?.height}
						class="w-full h-auto"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			)}

			<div class="grid md:grid-cols-[1fr_300px] gap-12 md:gap-14">
				<div class="space-y-12">
					<div>
						<h2 class="text-2xl font-bold text-white mb-4">About this project</h2>
						<p class="text-zinc-300 text-lg leading-relaxed whitespace-pre-line">{longDescription ?? description}</p>

						{collaborators && collaborators.length > 0 && (
							<p class="text-sm text-zinc-400 mt-6">
								<span class="uppercase tracking-widest mr-1">With:</span>
								{collaborators.map((collab, i) => (
									<Fragment>
										<a href={collab.url} target="_blank" rel="noopener noreferrer" class="text-zinc-200 hover:text-white transition underline">{collab.name}</a>
										{i < collaborators.length - 1 && ', '}
									</Fragment>
								))}
							</p>
						)}
					</div>

					{highlights && highlights.length > 0 && (
						<div>
							<h2 class="text-2xl font-bold text-white mb-5">What's in it</h2>
							<ul class="grid gap-3">
								{highlights.map(item => (
									<li class="flex items-start gap-3 text-zinc-200 rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-3.5">
										<svg class="w-5 h-5 shrink-0 mt-0.5" style={`color: ${accent}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
										</svg>
										<span>{item}</span>
									</li>
								))}
							</ul>
						</div>
					)}

					<div class="rounded-2xl border bg-zinc-950 p-6 sm:p-8" style={`border-color: ${accent}55`}>
						<p class="text-xs uppercase tracking-[0.25em] font-semibold mb-3" style={`color: ${accent}`}>The door is open</p>
						<h2 class="text-2xl font-bold text-white mb-3">{wip ? 'This one is still being built' : 'Want in on this one?'}</h2>
						{invite && <p class="text-zinc-200 text-lg leading-relaxed mb-3">{invite}</p>}
						<p class="text-zinc-400 leading-relaxed mb-6">
							{wip
								? "It's still taking shape, which makes this the best time to influence where it goes. Use it, pick it apart, or build on it with me."
								: download && !download.url
									? "It's done and in daily use. Ask for a copy and you can try it today. If you want to extend it, partner on it, or build something like it for your own idea, I'm up for the conversation."
									: "It's live, so you can try it today. If you want to extend it, partner on it, or build something like it for your own idea, I'm up for the conversation."}
						</p>
						<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
							<a href={talkLink} class="px-5 py-2.5 rounded-lg font-semibold text-sm transition hover:opacity-90" style={`background: ${accent}; color: #000`}>
								Talk to me about {title}
							</a>
							<a href="/about/#people" class="text-sm text-zinc-300 underline hover:text-white">How I work with people</a>
							<a href="/legal/#not-advice" class="text-sm text-zinc-400 underline hover:text-white">Provided as is</a>
						</div>
					</div>
				</div>

				<aside class="md:sticky md:top-24 self-start rounded-2xl border border-zinc-800 bg-zinc-950 p-6" aria-label="Project facts">
					<h2 class="text-xs uppercase tracking-[0.2em] text-zinc-400 font-semibold mb-5 font-sans">At a glance</h2>
					<dl class="space-y-5 text-sm">
						<div>
							<dt class="text-zinc-400 text-xs mb-1">Status</dt>
							<dd class="text-white flex items-center gap-2">
								<span class="w-2 h-2 rounded-full" style={`background: ${wip ? '#fbbf24' : '#34d399'}`} aria-hidden="true"></span>
								{wip ? 'In development' : 'Shipped and live'}
							</dd>
						</div>
						{role && (
							<div>
								<dt class="text-zinc-400 text-xs mb-1">Role</dt>
								<dd class="text-white">{role}</dd>
							</div>
						)}
						<div>
							<dt class="text-zinc-400 text-xs mb-1">Built by</dt>
							<dd><a href="/about/" class="text-white underline hover:no-underline">{profile.name}, {site.name}</a></dd>
						</div>
						{liveUrl && (
							<div>
								<dt class="text-zinc-400 text-xs mb-1">Lives at</dt>
								<dd>
									<a href={liveUrl} target="_blank" rel="noopener noreferrer" class="text-white underline hover:no-underline break-all">
										{new URL(liveUrl).hostname.replace(/^www\./, '')}<span class="sr-only"> (opens in a new tab)</span>
									</a>
								</dd>
							</div>
						)}
						{stack && stack.length > 0 && (
							<div>
								<dt class="text-zinc-400 text-xs mb-2">Built with</dt>
								<dd class="flex flex-wrap gap-2">
									{stack.map(item => (
										<a
											href={`/portfolio/?tech=${encodeURIComponent(item)}`}
											class="bg-zinc-900 text-zinc-200 px-2.5 py-1 rounded-full text-xs border border-zinc-700 hover:border-zinc-500 hover:text-white transition"
											title={`See every project built with ${item}`}
										>
											{item}
										</a>
									))}
								</dd>
							</div>
						)}
					</dl>
				</aside>
			</div>

			<nav class="mt-20 pt-10 border-t border-zinc-800 grid sm:grid-cols-2 gap-4" aria-label="More projects">
				{[
					{ label: 'Previous project', project: previous, align: 'text-left' },
					{ label: 'Next project', project: next, align: 'sm:text-right' },
				].map(item => (
					<a
						href={`/portfolio/${item.project.id}/`}
						class={`group rounded-2xl border border-zinc-800 bg-zinc-950 p-5 hover:border-zinc-600 transition ${item.align}`}
					>
						<span class="block text-xs uppercase tracking-[0.2em] text-zinc-400 font-semibold mb-2">{item.label}</span>
						<span class="block font-display text-xl font-bold text-white group-hover:underline">{item.project.title}</span>
						<span class="block text-sm text-zinc-400 mt-1 line-clamp-2">{item.project.description}</span>
					</a>
				))}
			</nav>
		</div>
	</section>
</Layout>
