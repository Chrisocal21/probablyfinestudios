---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title="Page not found | Probably Fine Studios" description="That page doesn't exist." noindex>
	<section class="relative overflow-hidden bg-black">
		<div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px); background-size: 40px 40px"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>

		<div class="relative max-w-2xl mx-auto px-4 sm:px-6 py-24 md:py-32 text-center">
			<p class="font-display text-8xl md:text-9xl font-bold text-white/15 leading-none mb-6" aria-hidden="true">404</p>
			<h1 class="text-3xl md:text-5xl font-bold text-white mb-4">This page is probably not fine.</h1>
			<p class="text-lg text-zinc-400 mb-10 leading-relaxed">
				It moved, it never existed, or I broke it. Everything else is still where it should be.
			</p>
			<div class="flex flex-wrap gap-3 justify-center">
				<a href="/" class="px-6 py-3 rounded-lg font-semibold text-sm bg-white text-black hover:bg-zinc-200 transition">Back to the homepage</a>
				<a href="/portfolio/" class="px-6 py-3 rounded-lg font-semibold text-sm border border-white/25 text-white hover:bg-white/10 transition">See the projects</a>
				<a href={site.contactHref} class="px-6 py-3 rounded-lg font-semibold text-sm border border-white/25 text-white hover:bg-white/10 transition">Tell me what broke</a>
			</div>
		</div>
	</section>
</Layout>
