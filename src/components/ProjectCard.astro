---
import ProjectIcon from './ProjectIcon.astro';

interface ProjectTheme {
	gradient: string;
	accent: string;
	pattern?: string;
	patternSize?: string;
}

interface Props {
	id: string;
	title: string;
	description: string;
	role?: string;
	image?: string;
	icon?: string;
	tags: string[];
	liveUrl?: string;
	githubUrl?: string;
	wip?: boolean;
	theme?: ProjectTheme;
	collaborators?: Array<{ name: string; url: string }>;
}

const { id, title, description, role, image, icon, tags, liveUrl, githubUrl, wip, theme, collaborators } = Astro.props;
const explicitPreviewClass = title === 'Hang'
	? 'object-cover object-[50%_44%]'
	: 'object-cover object-top';
---

<div class="bg-zinc-950 rounded-2xl overflow-hidden border border-zinc-800 hover:border-zinc-600 transition duration-300 flex flex-col shadow-xl">
	{image ? (
		<div class="relative rounded-t-2xl overflow-hidden border-b border-white/10">
			<div class="flex items-center gap-2 px-3 py-2 bg-black/70 border-b border-white/10">
				<div class="flex gap-1">
					<div class="w-2 h-2 rounded-full bg-red-500/70"></div>
					<div class="w-2 h-2 rounded-full bg-yellow-500/70"></div>
					<div class="w-2 h-2 rounded-full bg-green-500/70"></div>
				</div>
				<div class="flex-1 mx-2 bg-white/10 rounded px-2 py-0.5 text-xs text-gray-300 truncate">
					{liveUrl ? liveUrl.replace('https://', '') : `${title.toLowerCase().replace(/\s+/g, '')}.preview`}
				</div>
			</div>
			<div class="aspect-video bg-black relative overflow-hidden">
				<img
					src={image}
					alt={`${title} preview`}
					class={`block w-full h-full ${explicitPreviewClass}`}
					loading="lazy"
				/>
				<div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
			</div>
		</div>
	) : (
		<div class="relative aspect-[3/1.4] flex items-center justify-center overflow-hidden" style={`background: ${theme?.gradient ?? 'linear-gradient(135deg, #312e81, #1e1b4b)'}`}>
			{theme?.pattern && (
				<div class="absolute inset-0" style={`background-image: ${theme.pattern}; background-size: ${theme.patternSize ?? 'auto'}`}></div>
			)}
			<div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/10 to-black/50"></div>
			{icon && (
				<div class="relative" style={`color: ${theme?.accent ?? '#ffffff'}`}>
					<ProjectIcon icon={icon} class="w-12 h-12" />
				</div>
			)}
		</div>
	)}

	<!-- Content -->
	<div class="p-6 flex flex-col flex-1 gap-4">
		<div>
			<div class="flex items-start justify-between gap-3 mb-1">
				<h3 class="text-2xl font-bold text-white leading-tight">
					<a href={`/portfolio/${id}`} class="hover:underline">{title}</a>
				</h3>
				{wip && (
					<span class="text-[10px] font-medium tracking-widest uppercase px-2.5 py-0.5 rounded-full shrink-0 mt-1" style={`background: ${theme?.accent ?? '#fbbf24'}18; color: ${theme?.accent ?? '#fbbf24'}; border: 1px solid ${theme?.accent ?? '#fbbf24'}40`}>
						In Development
					</span>
				)}
			</div>
			<p class="text-[11px] uppercase tracking-[0.2em] font-semibold mb-2" style={`color: ${theme?.accent ?? '#a1a1aa'}`}>
				{role ?? tags[0]}{liveUrl ? ` · ${liveUrl.replace('https://', '').replace('www.', '').replace(/\/$/, '')}` : ''}
			</p>
			<p class="text-zinc-300 text-sm leading-relaxed">{description}</p>
		</div>

		<div class="flex flex-wrap gap-2">
			{tags.map(tag => (
				<span class="bg-white/5 text-zinc-200 px-2.5 py-1 rounded-full text-xs" style={`border: 1px solid ${theme?.accent ?? '#ffffff'}30`}>
					{tag}
				</span>
			))}
		</div>

		{collaborators && collaborators.length > 0 && (
			<p class="text-xs text-zinc-400">
				<span class="uppercase tracking-widest mr-1">With:</span>
				{collaborators.map((collab, i) => (
					<Fragment>
						<a href={collab.url} target="_blank" rel="noopener noreferrer" class="text-zinc-200 hover:text-white transition underline">{collab.name}</a>
						{i < collaborators.length - 1 && ', '}
					</Fragment>
				))}
			</p>
		)}

		<div class="flex gap-2 mt-auto pt-2">
			<a
				href={`/portfolio/${id}`}
				class="border border-gray-700 text-gray-300 px-4 py-2 rounded-lg text-sm hover:bg-gray-800 transition"
			>
				Case Study
			</a>
			{liveUrl && (
				<a
					href={liveUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="px-4 py-2 rounded-lg font-semibold text-sm transition hover:opacity-90"
					style={`background: ${theme?.accent ?? '#ffffff'}; color: #000`}
				>
					View Project
				</a>
			)}
			{githubUrl && (
				<a
					href={githubUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="border border-gray-700 text-gray-300 px-4 py-2 rounded-lg text-sm hover:bg-gray-800 transition"
				>
					View Code
				</a>
			)}
		</div>
	</div>
</div>
