---
import ProjectIcon from './ProjectIcon.astro';
import { liveLabel, type Project } from '../data/projects';

interface Props {
	project: Project;
	variant?: 'shipped' | 'exploring';
}

const { project, variant = 'shipped' } = Astro.props;
const { id, title, description, role, icon, tags, stack, liveUrl, download, githubUrl, wip, theme, collaborators } = project;
const accent = theme?.accent ?? '#71717a';
const exploring = variant === 'exploring';
const borderVars = exploring
	? `--card-border: ${accent}33; --card-border-hover: ${accent}80;`
	: `--card-border: ${accent}99; --card-border-hover: ${accent};`;
const where = liveLabel(project);
---

<article
	class={`project-card relative rounded-2xl overflow-hidden border border-[var(--card-border)] hover:border-[var(--card-border-hover)] transition duration-300 flex flex-col ${exploring ? 'bg-zinc-950/60 shadow-md' : 'bg-zinc-950 shadow-xl'}`}
	style={borderVars}
	data-stack={(stack ?? []).join('|')}
>
	{wip && (
		<span class="absolute top-3 right-3 z-10 text-[10px] font-semibold tracking-widest uppercase px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-sm" style={`color: ${theme?.accent ?? '#fbbf24'}; border: 1px solid ${theme?.accent ?? '#fbbf24'}55`}>
			In Development
		</span>
	)}
	<div class={exploring ? 'opacity-75' : ''} aria-hidden="true">
		<div class="relative aspect-[3/1.4] flex items-center justify-center overflow-hidden" style={`background: ${theme?.gradient ?? 'linear-gradient(135deg, #312e81, #1e1b4b)'}`}>
			{theme?.pattern && (
				<div class="absolute inset-0" style={`background-image: ${theme.pattern}; background-size: ${theme.patternSize ?? 'auto'}`}></div>
			)}
			<div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/10 to-black/50"></div>
			{icon && (
				<div class="relative" style={`color: ${theme?.accent ?? '#ffffff'}`}>
					<ProjectIcon icon={icon} class="w-12 h-12" />
				</div>
			)}
		</div>
	</div>

	<div class="p-6 flex flex-col flex-1 gap-4">
		<div>
			<h3 class="text-2xl font-bold text-white leading-tight mb-1.5">
				<a href={`/portfolio/${id}/`} class="hover:underline">{title}</a>
			</h3>
			<p class="text-[11px] uppercase tracking-[0.2em] font-semibold mb-2" style={`color: ${theme?.accent ?? '#a1a1aa'}`}>
				{role ?? tags[0]}{where ? ` · ${where}` : ''}
			</p>
			<p class="text-zinc-300 text-sm leading-relaxed">{description}</p>
		</div>

		<ul class="flex flex-wrap gap-1.5" aria-label="Categories">
			{tags.map(tag => (
				<li class="text-zinc-400 px-2 py-0.5 rounded-full text-[11px]" style={`border: 1px solid ${theme?.accent ?? '#ffffff'}20`}>
					{tag}
				</li>
			))}
		</ul>

		{collaborators && collaborators.length > 0 && (
			<p class="text-xs text-zinc-400">
				<span class="uppercase tracking-widest mr-1">With:</span>
				{collaborators.map((collab, i) => (
					<Fragment>
						<a href={collab.url} target="_blank" rel="noopener noreferrer" class="text-zinc-200 hover:text-white transition underline">{collab.name}</a>
						{i < collaborators.length - 1 && ', '}
					</Fragment>
				))}
			</p>
		)}

		<div class="flex flex-wrap gap-2 mt-auto pt-2">
			<a
				href={`/portfolio/${id}/`}
				class="border border-zinc-700 text-zinc-200 px-4 py-2 rounded-lg text-sm hover:bg-zinc-800 transition"
			>
				Case Study<span class="sr-only">: {title}</span>
			</a>
			{liveUrl && (
				<a
					href={liveUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="px-4 py-2 rounded-lg font-semibold text-sm transition hover:opacity-90"
					style={`background: ${theme?.accent ?? '#ffffff'}; color: #000`}
				>
					View Project<span class="sr-only">: {title} (opens in a new tab)</span>
				</a>
			)}
			{download && (download.url ? (
				<a
					href={download.url}
					class="px-4 py-2 rounded-lg font-semibold text-sm transition hover:opacity-90"
					style={`background: ${theme?.accent ?? '#ffffff'}; color: #000`}
				>
					{download.label}<span class="sr-only">: {title}</span>
				</a>
			) : (
				<span class="border border-dashed border-zinc-600 text-zinc-300 px-4 py-2 rounded-lg text-sm">
					Download: soon
				</span>
			))}
			{githubUrl && (
				<a
					href={githubUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="border border-zinc-700 text-zinc-200 px-4 py-2 rounded-lg text-sm hover:bg-zinc-800 transition"
				>
					View Code<span class="sr-only">: {title} (opens in a new tab)</span>
				</a>
			)}
		</div>
	</div>
</article>
