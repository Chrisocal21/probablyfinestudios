---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../data/projects';

interface Props {
	id: string;
	title: string;
	subtitle: string;
	projects: Project[];
	/** `mixed` styles each card by its own status, for sections grouped by type rather than status. */
	variant: 'shipped' | 'exploring' | 'mixed';
	/** Show this many cards, then a "See more" button for the rest. Without JavaScript every card shows. */
	limit?: number;
	seeAllHref?: string;
	seeAllLabel?: string;
}

const { id, title, subtitle, projects, variant, limit, seeAllHref, seeAllLabel } = Astro.props;
const extra = limit && projects.length > limit ? projects.length - limit : 0;
const exploring = variant === 'exploring';
---

<section id={id} class="project-section scroll-mt-24" aria-labelledby={`${id}-heading`} data-limit={extra ? limit : undefined}>
	<div class="mb-8">
		<h2 id={`${id}-heading`} class={exploring ? 'text-2xl font-bold text-zinc-200' : 'text-3xl font-bold text-white'}>
			{title}
			<span class="project-count ml-2 align-middle text-sm font-medium text-zinc-400 font-sans tracking-normal">{projects.length}</span>
		</h2>
		<p class="mt-2 text-zinc-400">{subtitle}</p>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
		{projects.map((project, index) => (
			<div class="contents" data-extra={limit && index >= limit ? '' : undefined}>
				<ProjectCard project={project} variant={variant === 'mixed' ? (project.wip ? 'exploring' : 'shipped') : variant} />
			</div>
		))}
	</div>
	<div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
		{extra > 0 && (
			<button type="button" class="see-more hidden px-5 py-2.5 rounded-lg font-semibold text-sm border border-white/25 text-white hover:bg-white/10 transition" aria-expanded="false" data-more={`See more (${extra})`} data-less="Show fewer">
				See more ({extra})
			</button>
		)}
		{seeAllHref && (
			<a href={seeAllHref} class="text-sm font-semibold text-zinc-100 hover:text-white underline underline-offset-4">{seeAllLabel ?? 'See all'} &rarr;</a>
		)}
	</div>
</section>

<style is:global>
	.project-section[data-collapsed] [data-extra] {
		display: none;
	}
</style>

<script>
	// Sections with a limit start collapsed; the button reveals the rest. Without JavaScript all cards show.
	for (const section of document.querySelectorAll<HTMLElement>('.project-section[data-limit]')) {
		const button = section.querySelector<HTMLButtonElement>('.see-more');
		if (!button) continue;
		section.setAttribute('data-collapsed', '');
		section.setAttribute('data-collapsible', '');
		button.classList.remove('hidden');
		button.addEventListener('click', () => {
			const expand = section.hasAttribute('data-collapsed');
			section.toggleAttribute('data-collapsed', !expand);
			button.setAttribute('aria-expanded', String(expand));
			button.textContent = expand ? button.dataset.less ?? '' : button.dataset.more ?? '';
		});
	}
</script>
