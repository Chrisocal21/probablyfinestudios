---
interface Props {
	icon: string;
	class?: string;
}

const { icon, class: className = 'w-10 h-10' } = Astro.props;
---

{icon === 'camera' && (
	<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
	</svg>
)}
{icon === 'book' && (
	<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.5c-1.5-1-3.5-1.5-5-1.5-1 0-2 .1-3 .4v13c1-.3 2-.4 3-.4 1.5 0 3.5.5 5 1.5m0-13c1.5-1 3.5-1.5 5-1.5 1 0 2 .1 3 .4v13c-1-.3-2-.4-3-.4-1.5 0-3.5.5-5 1.5m0-13v13"/>
	</svg>
)}
{icon === 'calendar' && (
	<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<rect x="3" y="5" width="18" height="16" rx="2" stroke-width="1.5"/>
		<line x1="3" y1="9.5" x2="21" y2="9.5" stroke-width="1.5"/>
		<line x1="8" y1="3" x2="8" y2="7" stroke-width="1.5" stroke-linecap="round"/>
		<line x1="16" y1="3" x2="16" y2="7" stroke-width="1.5" stroke-linecap="round"/>
	</svg>
)}
{icon === 'plane' && (
	<svg class={className} fill="currentColor" viewBox="0 0 24 24">
		<path d="M3 11l18-8-8 18-2-8-8-2z"/>
	</svg>
)}
{icon === 'pin' && (
	<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21s7-6.5 7-12a7 7 0 10-14 0c0 5.5 7 12 7 12z"/>
		<circle cx="12" cy="9" r="2.5" stroke-width="1.5"/>
	</svg>
)}
{icon === 'grid' && (
	<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<rect x="4" y="4" width="7" height="7" rx="1.2" stroke-width="1.5"/>
		<rect x="13" y="4" width="7" height="7" rx="1.2" stroke-width="1.5"/>
		<rect x="4" y="13" width="7" height="7" rx="1.2" stroke-width="1.5"/>
		<rect x="13" y="13" width="7" height="7" rx="1.2" stroke-width="1.5"/>
	</svg>
)}
{icon === 'chat' && (
	<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4-.8L3 20l1.2-3.6A7.93 7.93 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
	</svg>
)}
{icon === 'calculator' && (
	<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<rect x="5" y="3" width="14" height="18" rx="2" stroke-width="1.5"/>
		<rect x="7.5" y="5.5" width="9" height="3.5" rx="0.5" stroke-width="1.5"/>
		<circle cx="8.5" cy="13" r="1" fill="currentColor" stroke="none"/>
		<circle cx="12" cy="13" r="1" fill="currentColor" stroke="none"/>
		<circle cx="15.5" cy="13" r="1" fill="currentColor" stroke="none"/>
		<circle cx="8.5" cy="17" r="1" fill="currentColor" stroke="none"/>
		<circle cx="12" cy="17" r="1" fill="currentColor" stroke="none"/>
		<circle cx="15.5" cy="17" r="1" fill="currentColor" stroke="none"/>
	</svg>
)}
{icon === 'globe' && (
	<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<circle cx="12" cy="12" r="9" stroke-width="1.5"/>
		<line x1="12" y1="3" x2="12" y2="21" stroke-width="1.5"/>
		<line x1="3" y1="12" x2="21" y2="12" stroke-width="1.5"/>
	</svg>
)}
{icon === 'pencil' && (
	<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 20l4-1 10-10-3-3-10 10-1 4z"/>
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 7l3 3"/>
	</svg>
)}
{icon === 'gear' && (
	<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<circle cx="12" cy="12" r="3" stroke-width="1.5"/>
		<line x1="12" y1="2" x2="12" y2="6" stroke-width="1.5" stroke-linecap="round"/>
		<line x1="12" y1="18" x2="12" y2="22" stroke-width="1.5" stroke-linecap="round"/>
		<line x1="2" y1="12" x2="6" y2="12" stroke-width="1.5" stroke-linecap="round"/>
		<line x1="18" y1="12" x2="22" y2="12" stroke-width="1.5" stroke-linecap="round"/>
		<line x1="4.9" y1="4.9" x2="7.8" y2="7.8" stroke-width="1.5" stroke-linecap="round"/>
		<line x1="16.2" y1="16.2" x2="19.1" y2="19.1" stroke-width="1.5" stroke-linecap="round"/>
		<line x1="4.9" y1="19.1" x2="7.8" y2="16.2" stroke-width="1.5" stroke-linecap="round"/>
		<line x1="16.2" y1="7.8" x2="19.1" y2="4.9" stroke-width="1.5" stroke-linecap="round"/>
	</svg>
)}
