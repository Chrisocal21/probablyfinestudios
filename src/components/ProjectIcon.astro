---
import { projectIcons } from '../data/icons';

interface Props {
	icon: string;
	class?: string;
}

const { icon, class: className = 'w-10 h-10' } = Astro.props;
---

{projectIcons[icon] && (
	<svg
		class={className}
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
		viewBox="0 0 24 24"
		aria-hidden="true"
		set:html={projectIcons[icon]}
	/>
)}
