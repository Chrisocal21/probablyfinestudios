---
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-mark.png';
import { site } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
	const target = href.replace(/\/$/, '') || '/';
	return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header class="sticky top-0 z-50 border-b border-zinc-800/80 bg-black/80 backdrop-blur-md print:hidden">
	<nav aria-label="Main" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
		<a href="/" class="flex items-center gap-2.5 shrink-0">
			<Image src={logoMark} alt="" width={196} class="h-7 md:h-8 w-auto" loading="eager" />
			<span class="leading-none font-display">
				<span class="block text-white font-bold text-base md:text-lg tracking-tight">Probably Fine</span>
				<span class="block text-zinc-400 text-[10px] md:text-xs tracking-[0.2em] uppercase mt-0.5">Studios</span>
			</span>
			<span class="sr-only">home page</span>
		</a>

		<div class="flex items-center gap-1 sm:gap-2">
			<ul class="hidden md:flex items-center gap-1 mr-2">
				{site.nav.map(link => (
					<li>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? 'page' : undefined}
							class={`px-3 py-2 rounded-lg text-sm transition ${isActive(link.href) ? 'text-white font-semibold bg-white/10' : 'text-zinc-300 hover:text-white hover:bg-white/5'}`}
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>

			<a href={site.contactHref} class="bg-white text-black px-4 py-2 rounded-lg hover:bg-zinc-200 transition text-sm font-semibold whitespace-nowrap">
				<span class="sm:hidden">Contact</span>
				<span class="hidden sm:inline">Work with me</span>
			</a>

			<details id="nav-menu" class="md:hidden relative">
				<summary
					class="flex items-center justify-center w-10 h-10 -mr-2 text-zinc-300 cursor-pointer list-none rounded-lg hover:bg-white/5 [&::-webkit-details-marker]:hidden"
					aria-label="Menu"
				>
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
					</svg>
				</summary>
				<ul class="absolute right-0 top-full mt-3 w-56 rounded-xl border border-zinc-800 bg-zinc-950 p-2 shadow-2xl">
					<li>
						<a href="/" class={`block px-3 py-2.5 rounded-lg transition ${currentPath === '/' ? 'text-white font-semibold bg-white/10' : 'text-zinc-300 hover:bg-white/5'}`}>Home</a>
					</li>
					{site.nav.map(link => (
						<li>
							<a
								href={link.href}
								aria-current={isActive(link.href) ? 'page' : undefined}
								class={`block px-3 py-2.5 rounded-lg transition ${isActive(link.href) ? 'text-white font-semibold bg-white/10' : 'text-zinc-300 hover:bg-white/5'}`}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</details>
		</div>
	</nav>
</header>

<script>
	// Close the mobile menu on Escape or a click outside it.
	const menu = document.getElementById('nav-menu');
	if (menu instanceof HTMLDetailsElement) {
		document.addEventListener('click', event => {
			if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
		});
		document.addEventListener('keydown', event => {
			if (event.key === 'Escape') menu.open = false;
		});
	}
</script>
